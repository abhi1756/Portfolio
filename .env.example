# Copy this file to .env and fill in the values. Never commit .env.

# Public URL of the deployed site, no trailing slash. Used for canonical,
# Open Graph and sitemap URLs.
VITE_SITE_URL=https://your-domain.com

# Web3Forms access key (https://web3forms.com). This key is designed to be
# public: it only lets the form send email to the address you registered,
# so it is safe in frontend code. Leave empty to disable the form; visitors
# then see your email address instead.
VITE_WEB3FORMS_ACCESS_KEY=
